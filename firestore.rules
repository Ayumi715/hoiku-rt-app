rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner()  { return signedIn() && resource.data.ownerUid == request.auth.uid; }
    function isExpert() { return signedIn() && request.auth.token.role == 'expert'; }
    function ownsNew()  { return signedIn() && request.resource.data.ownerUid == request.auth.uid; }

    match /facilities/{facilityId} {
      allow read: if isOwner() || isExpert();
      allow create: if ownsNew()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.volume is number
        && request.resource.data.volume > 0;
      allow update, delete: if false;
    }

    match /measurements/{measurementId} {
      allow read: if isOwner() || isExpert();
      allow create: if ownsNew()
        && request.resource.data.facilityId is string
        && request.resource.data.rt60 is number
        && request.resource.data.edt is number
        && request.resource.data.bands is list
        && existsAfter(/databases/$(database)/documents/facilities/$(request.resource.data.facilityId))
        && getAfter(/databases/$(database)/documents/facilities/$(request.resource.data.facilityId)).data.ownerUid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}